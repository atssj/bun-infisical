# EditorConfig for consistent editor settings
# See https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[Dockerfile]
indent_size = 2

[*.{html,css,js}]
indent_size = 2

[Makefile]
indent_style = tab